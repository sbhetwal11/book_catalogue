<div class="card p-4">
  <h5 class="mb-3">Add Book</h5>
  <% if @error %>
    <div class="alert alert-danger" role="alert"><%= h @error %></div>
  <% end %>

  <form method="post" action="/create" class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Title</label>
      <input class="form-control" name="title" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Author</label>
      <input class="form-control" name="author" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Genre</label>
      <input class="form-control" name="genre" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">Year</label>
      <input class="form-control" type="number" name="year" min="0" max="9999" required>
    </div>
    <div class="col-12">
      <button class="btn btn-brand text-white">Add</button>
      <a class="btn btn-outline-secondary" href="/">Cancel</a>
    </div>
  </form>
</div>
