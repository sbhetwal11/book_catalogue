<div class="d-flex justify-content-between align-items-center mb-3">
  <h5 class="mb-0">Report by <%= h(@group.capitalize) %></h5>
  <div class="btn-group">
    <a class="btn btn-outline-secondary btn-sm" href="/report?group=genre">By Genre</a>
    <a class="btn btn-outline-secondary btn-sm" href="/report?group=author">By Author</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card p-3">
      <canvas id="reportChart" height="180"></canvas>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card p-0">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead><tr><th><%= h(@group.capitalize) %></th><th>Count</th></tr></thead>
          <tbody>
          <% if @rows.empty? %>
            <tr><td class="text-muted" colspan="2">No data.</td></tr>
          <% else %>
            <% @rows.each do |r| %>
              <tr><td><%= h r['label'] %></td><td><%= h r['count'] %></td></tr>
            <% end %>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js only on this page -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const dataset = <%= JSON.generate(@rows.map{|r| {label: r['label'], count: r['count']} }) %>;
  const labels = dataset.map(d => d.label);
  const counts = dataset.map(d => d.count);

  new Chart(document.getElementById('reportChart'), {
    type: 'bar',
    data: {
      labels,
      datasets: [{ data: counts, borderWidth: 1 }]
    },
    options: {
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
    }
  });
</script>

